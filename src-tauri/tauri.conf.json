{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carrier",
  "version": "0.1.0",
  "identifier": "com.carrier.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../webui/static",
    "devUrl": "../webui/static/index.html"
  },
  "app": {
    "windows": [
      {
        "title": "Carrier",
        "width": 1366,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["all"]
  },
  "plugins": {}
}
