{
  "id": "openclaw",
  "name": "OpenClaw",
  "version": "1.0.0",
  "description": "Full-featured AI assistant with memory support",
  "capabilities": [
    "chat",
    "code",
    "memory"
  ],
  "runtime": {
    "type": "local_binary",
    "install": {
      "command": "npm install -g openclaw@1.0.0"
    },
    "upgrade": {
      "command": "npm install -g openclaw@1.0.0"
    },
    "start": {
      "command": "openclaw gateway"
    },
    "stop": {
      "command": "openclaw gateway stop"
    }
  },
  "network": {
    "ports": [],
    "healthcheck": {
      "type": "http",
      "url": "http://localhost:9090/healthz"
    }
  },
  "env": {
    "required": [],
    "optional": [
      {
        "name": "LOG_LEVEL",
        "default": "info",
        "description": "Logging verbosity level"
      }
    ]
  },
  "memory": {
    "supports": [
      "per_agent",
      "shared",
      "public"
    ],
    "mount_path": "./memory"
  },
  "upgrade": {
    "channel": "stable",
    "strategy": "in_place_or_reinstall"
  },
  "health": {
    "interval_seconds": 30,
    "timeout_seconds": 5,
    "retries": 3,
    "restart_loop_window": 300,
    "restart_loop_max": 5
  },
  "diagnostics": {
    "include": [
      "runtime_logs",
      "process_state",
      "env_sanitized"
    ]
  },
  "checksums": {
    "_note": "Populate with real SHA-256 hashes at release time. Install script fails-closed without valid checksums."
  }
}
