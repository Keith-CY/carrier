{
  "id": "openclaw",
  "name": "OpenClaw",
  "version": "1.0.0",
  "description": "Full-featured AI assistant with memory support",
  "capabilities": [
    "chat",
    "code",
    "memory"
  ],
  "runtime": {
    "type": "local_binary",
    "install": {
      "command": "OPENCLAW_VERSION=1.0.0 sh ./catalog/scripts/install-openclaw.sh",
      "platforms": {
        "linux": "OPENCLAW_VERSION=1.0.0 sh ./catalog/scripts/install-openclaw.sh",
        "darwin": "OPENCLAW_VERSION=1.0.0 sh ./catalog/scripts/install-openclaw.sh",
        "windows": "npm install -g openclaw@1.0.0"
      }
    },
    "upgrade": {
      "command": "OPENCLAW_VERSION=1.0.0 sh ./catalog/scripts/install-openclaw.sh",
      "platforms": {
        "linux": "OPENCLAW_VERSION=1.0.0 sh ./catalog/scripts/install-openclaw.sh",
        "darwin": "OPENCLAW_VERSION=1.0.0 sh ./catalog/scripts/install-openclaw.sh",
        "windows": "npm update -g openclaw@1.0.0"
      }
    },
    "start": {
      "command": "openclaw --config ./config.yaml",
      "platforms": {
        "linux": "openclaw --config ./config.yaml",
        "darwin": "openclaw --config ./config.yaml",
        "windows": "wsl.exe bash -lc 'openclaw --config ./config.yaml'"
      }
    },
    "stop": {
      "command": "openclaw --stop",
      "platforms": {
        "linux": "openclaw --stop",
        "darwin": "openclaw --stop",
        "windows": "wsl.exe bash -lc 'openclaw --stop'"
      }
    }
  },
  "network": {
    "ports": [
      {
        "name": "http",
        "port": 8080
      }
    ],
    "healthcheck": {
      "type": "http",
      "url": "http://localhost:8080/health"
    }
  },
  "env": {
    "required": [
      {
        "name": "OPENAI_API_KEY",
        "secret": true,
        "description": "OpenAI API key for LLM access"
      }
    ],
    "optional": [
      {
        "name": "LOG_LEVEL",
        "default": "info",
        "description": "Logging verbosity level"
      }
    ]
  },
  "memory": {
    "supports": [
      "per_agent",
      "shared",
      "public"
    ],
    "mount_path": "./memory"
  },
  "upgrade": {
    "channel": "stable",
    "strategy": "in_place_or_reinstall"
  },
  "health": {
    "interval_seconds": 30,
    "timeout_seconds": 5,
    "retries": 3,
    "restart_loop_window": 300,
    "restart_loop_max": 5
  },
  "diagnostics": {
    "include": [
      "runtime_logs",
      "process_state",
      "env_sanitized"
    ]
  }
}
